<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:padding="@dimen/screen_padding">
  <EditText
    android:id="@+id/edit_text_sample"
    android:layout_width="match_parent"
    android:layout_height="@dimen/sample_height"
    android:gravity="bottom|start"
    android:hint="@string/sample_hint"
    android:inputType="textMultiLine"
    android:autofillHints=""
    android:textColor="@color/black" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/row_spacing"
    android:orientation="horizontal">
    <Button
      android:id="@+id/button_black_text"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_margin="@dimen/control_margin"
      android:backgroundTint="@color/purple"
      android:text="@string/black_text"
      android:textColor="@color/white" />
    <Button
      android:id="@+id/button_red_text"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_margin="@dimen/control_margin"
      android:backgroundTint="@color/purple"
      android:text="@string/red_text"
      android:textColor="@color/white" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/row_spacing"
    android:orientation="horizontal">
    <Button
      android:id="@+id/button_small_text"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_margin="@dimen/control_margin"
      android:backgroundTint="@color/purple"
      android:text="@string/small_text"
      android:textColor="@color/white" />
    <Button
      android:id="@+id/button_large_text"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_margin="@dimen/control_margin"
      android:backgroundTint="@color/purple"
      android:text="@string/large_text"
      android:textColor="@color/white" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/row_spacing"
    android:orientation="horizontal">
    <Button
      android:id="@+id/button_white_background"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_margin="@dimen/control_margin"
      android:backgroundTint="@color/purple"
      android:text="@string/white_background"
      android:textColor="@color/white" />
    <Button
      android:id="@+id/button_yellow_background"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_margin="@dimen/control_margin"
      android:backgroundTint="@color/purple"
      android:text="@string/yellow_background"
      android:textColor="@color/white" />
  </LinearLayout>

</LinearLayout>
